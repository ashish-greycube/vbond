 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") %}\n{% set company_doc = frappe.get_doc(\"Company\", company) %}\n{% set owner_name = frappe.db.get_value(\"User\", doc.owner, \"full_name\") %}\n{% set ns = namespace(po_no=[]) %}\n\n{% for row in doc.items %}\n    {% if row.purchase_order not in ns.po_no and row.purchase_order %}\n    <p style=\"display: none;\">\n        {{ ns.po_no.append(row.purchase_order) }}\n    </p>\n    {% endif %}\n{% endfor %}\n\n<div style=\"display: flex; flex-direction: column; min-height: 96vh; justify-content: space-between;\">\n    <div style=\"\">\n        <center><h2><strong>MATERIAL RECEIPT NOTE</strong></h2></center>\n        \n        <table border=\"1\" style=\"width:100%; font-size:13px; border-color: black; border-collapse: collapse;\">\n            <tr>\n                <td colspan=\"3\" rowspan=\"4\" >\n                    <div style=\"display: flex;\">\n                        <div>\n                            <img style=\"height: 80px; padding-right: 8px;\" class=\"logo-img\" src=\"{{company_doc.company_logo}}\" alt=\"Company Logo\">\n                        </div>\n                        <div><strong>{{company_doc.name}}</strong> <br> {{doc.shipping_address_display}}</div>\n                    </div>\n                </td>\n                <td colspan=\"3\">DATE: <strong>{{doc.posting_date}}</strong></td>\n            </tr>\n            <tr>\n                <td colspan=\"3\">ID: <br> <strong>{{doc.name}}</strong></td>\n            </tr>\n            <tr>\n                <td colspan=\"3\">MRN NO: <br> <strong>{{doc.custom_mrn_number or \"\"}}</strong></td>\n            </tr>\n            <tr>\n                <td colspan=\"3\">SUPPLIER INV/DC NO: <br> <strong>{{doc.supplier_delivery_note or \"\"}}</strong></td>\n            </tr>\n            \n            <tr>\n                <td colspan=\"3\" rowspan=\"2\">SUPPLIER <br> <strong>{{doc.supplier or \"\"}}</strong> <br> {{doc.address_display or \"\"}}</td>\n                <td colspan=\"3\">PO NO: <br> <strong>{{ ns.po_no | join(', ') }}</strong></td>\n            </tr>\n            <tr>\n                <td colspan=\"3\">WAREHOUSE: <br> <strong>{{doc.set_warehouse or \"\"}}</strong></td>\n            </tr>\n            \n            <tr style=\"font-weight: bold;\">\n                <td>Sr. No.</td>\n                <td>Description Of Goods</td>\n                <td>HSN Code</td>\n                <td>Qty</td>\n                <td>UOM</td>\n                <td>Remarks</td>\n            </tr>\n            {% for row in doc.items %}\n                <tr>\n                    <td>{{loop.index}}</td>\n                    <td>{{row.description or \"\"}}</td>\n                    <td>{{row.gst_hsn_code or \"\"}}</td>\n                    <td>{{row.qty or \"\"}}</td>\n                    <td>{{row.uom or \"\"}}</td>\n                    <td></td>\n                </tr>\n            {% endfor %}\n        </table>\n    </div>\n    \n    <div style=\"border: 1px solid black; display: flex; flex-grow: 1; border-top: none; border-bottom: none;\"></div>\n    \n    <div>\n        <table border=\"1\" style=\"width:100%; font-size:13px; border-color: black; width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td width=\"33%\" colspan=\"2\"><center> Prepared By <br><br><br><br> {{owner_name}} </center></td>\n                <td width=\"33%\" colspan=\"2\"> <br><br><br><br> <center>Quality Approved By </center></td>\n                <td width=\"33%\" colspan=\"2\"> <br><br><br><br> <center>Plant Head / Authorised By </center></td>\n            </tr>\n        </table>\n    </div>\n</div>\n\n\n\n\n",
