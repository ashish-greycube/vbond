 "html": "{% set company = frappe.db.get_single_value(\"Global Defaults\", \"default_company\") %}\n{% set company_doc = frappe.get_doc(\"Company\", company) %}\n{% set owner_name = frappe.db.get_value(\"User\", doc.owner, \"full_name\") %}\n{% set ns = namespace(po_no=[]) %}\n\n{% for row in doc.items %}\n    {% if row.purchase_order not in ns.po_no and row.purchase_order %}\n    <p style=\"display: none;\">\n        {{ ns.po_no.append(row.purchase_order) }}\n    </p>\n    {% endif %}\n{% endfor %}\n\n<style>\n    /* Absolute Print Boundaries to force a full-page box grid layout */\n    @page {\n        size: A4 portrait;\n        margin: 15mm 10mm 15mm 10mm;\n    }\n    \n    .page-container {\n        width: 100%;\n        height: 900px; /* Forces layout table completely down to the bottom margin boundary */\n        box-sizing: border-box;\n        font-family: Arial;\n    }\n    \n    .master-table {\n        width: 100%;\n        height: 100%; /* Spreads structural cells across the exact container dimension */\n        font-size: 11px; \n        border-color: black; \n        border-collapse: collapse;\n    }\n</style>\n\n<div class=\"page-container\">\n    <center><h2 style=\"margin-top: 0; margin-bottom: 15px;\"><strong>MATERIAL RECEIPT NOTE</strong></h2></center>\n    \n    <table border=\"1\" class=\"master-table\">\n        \n        <tr>\n            <td colspan=\"8\" rowspan=\"4\" style=\"width: 66.66%; vertical-align: middle;\">\n                <div style=\"width: 20%; float: left; vertical-align: middle;\">\n                    {% if company_doc.company_logo %}\n                        <img style=\"height: 100px; max-width: 100%; vertical-align: middle; margin-top: 10px;\" class=\"logo-img\" src=\"{{company_doc.company_logo}}\" alt=\"Company Logo\">\n                    {% endif %}\n                </div>\n                <div style=\"width: 80%; float: left; padding-left: 10px;\">\n                    <strong>{{company_doc.name}}</strong><br>\n                    <span style=\"font-size: 11px; color: #333; line-height: 1.3;\">{{doc.shipping_address_display or \"\"}}</span>\n                </div>\n            </td>\n            <td colspan=\"4\" style=\"width: 33.33%; height: 32px;\">DATE: <strong>{{doc.posting_date}}</strong></td>\n        </tr>\n        <tr>\n            <td colspan=\"4\" style=\"height: 32px;\">ID: <strong>{{doc.name}}</strong></td>\n        </tr>\n        <tr>\n            <td colspan=\"4\" style=\"height: 32px;\">MRN NO: <strong>{{doc.custom_mrn_number or \"\"}}</strong></td>\n        </tr>\n        <tr>\n            <td colspan=\"4\" style=\"height: 32px;\">SUPPLIER INV/DC NO: <strong>{{doc.supplier_delivery_note or \"\"}}</strong></td>\n        </tr>\n        \n        <tr>\n            <td colspan=\"8\" rowspan=\"2\" style=\"vertical-align: top;\">\n                SUPPLIER<br>\n                <strong>{{doc.supplier or \"\"}}</strong><br>\n                <span style=\"font-size: 11px; color: #333; line-height: 1.3;\">{{doc.address_display or \"\"}}</span>\n            </td>\n            <td colspan=\"4\" style=\"height: 32px; vertical-align: top !important;\">PO NO: <br> <strong>{{ ns.po_no | join(', ') }}</strong></td>\n        </tr>\n        <tr>\n            <td colspan=\"4\" style=\"height: 32px; vertical-align: top !important;\">WAREHOUSE: <br> <strong>{{doc.set_warehouse or \"\"}}</strong></td>\n        </tr>\n        \n        <tr style=\"font-weight: bold; background-color: #f9f9f9; text-align: center; height: 30px;\">\n            <td colspan=\"1\" style=\"width: 8.33%;\">Sr. No.</td>\n            <td colspan=\"5\" style=\"width: 41.66%;\">Description Of Goods</td>\n            <td colspan=\"2\" style=\"width: 16.66%;\">HSN Code</td>\n            <td colspan=\"1\" style=\"width: 8.33%;\">Qty</td>\n            <td colspan=\"1\" style=\"width: 8.33%;\">UOM</td>\n            <td colspan=\"2\" style=\"width: 16.66%;\">Remarks</td>\n        </tr>\n        \n        {% for row in doc.items %}\n            <tr style=\"height: 35px;\">\n                <td colspan=\"1\" style=\"text-align: center;\">{{loop.index}}</td>\n                <td colspan=\"5\" style=\"vertical-align: middle;\">\n                    {{row.item_name}} <br>\n                    {{row.item_code}} - {{row.description or \"\"}}\n                </td>\n                <td colspan=\"2\" style=\"text-align: center;\">{{row.gst_hsn_code or \"\"}}</td>\n                <td colspan=\"1\" style=\"text-align: center;\">{{row.qty or \"\"}}</td>\n                <td colspan=\"1\" style=\"text-align: center;\">{{row.uom or \"\"}}</td>\n                <td colspan=\"2\"></td>\n            </tr>\n        {% endfor %}\n        \n        <tr>\n            <td colspan=\"12\" style=\"border-top: none; border-bottom: none;\"></td>\n        </tr>\n        \n        <tr style=\"text-align: center; font-weight: bold; height: 110px;\">\n            <td colspan=\"4\" style=\"width: 33.33%; vertical-align: top; border-top: 1px solid black;\">\n                Prepared By\n                <div style=\"margin-top: 55px; font-weight: normal; font-size: 11px;\">{{owner_name}}</div>\n            </td>\n            <td colspan=\"4\" style=\"width: 33.33%; vertical-align: bottom !important; border-top: 1px solid black; padding-bottom: 10px !important;\">\n                Quality Approved By\n            </td>\n            <td colspan=\"4\" style=\"width: 33.33%; vertical-align: bottom !important; border-top: 1px solid black; padding-bottom: 10px !important;\">\n                Plant Head / Authorised By\n            </td>\n        </tr>\n        \n    </table>\n</div>",
