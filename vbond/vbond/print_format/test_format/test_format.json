 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% if print_settings.repeat_header_footer %}\n    <div id=\"header-html\">\n   </div>\n{% endif %}\n\n\n\n{% for i in range(1, 5)%}\n\n{% if loop.index > 1%}\n    <div class=\"page-break\"></div>\n{% endif %}\n\n<div class=\"invoice-container\">\n    <table>\n        <tr>\n            <td>\n                <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                    <div style=\"width: 100%; text-align: center;\">\n                        <p class=\"invoice-title\">\n                            <b>{% if doc.is_return == 1 %}\n                                  CREDIT NOTE\n                                {% else %}\n                                  TAX INVOICE\n                                {% endif %}\n                            </b>\n                        </p>\n                    </div>\n                    <div style=\"text-align: right; font-size: 14px; flex-shrink: 0;\">\n                        {% if loop.index == 1 %}\n                            {% set heading = \"Original For Recipient\" %}\n                        {% elif loop.index == 2 %}\n                            {% set heading = \"Triplicate for Supplier\" %}\n                        {% elif loop.index == 3 %}\n                            {% set heading = \"Duplicate for Supplier\" %}\n                        {% elif loop.index == 4 %}\n                            {% set heading = \"Duplicate for Transporter\" %}\n                        {% endif %}\n                      <i>({{ heading }})</i>\n                    </div>\n                </div>\n                {% if doc.irn %}\n                {% set e_invoice_log = frappe.db.get_value( \"e-Invoice Log\", doc.irn,\n                (\"invoice_data\", \"signed_qr_code\"), as_dict=True ) %}\n                \n                {% if e_invoice_log %}\n                {% set invoice_data = json.loads(e_invoice_log.invoice_data) %}\n                {% set date_format = frappe.db.get_single_value(\"System Settings\",'date_format').replace(\"mm\",\"MM\")\n                %}\n                {% endif %}{% endif %}\n                <p style=\"font-size:14px;\">\n                    {% if not doc.irn %}\n                    \t<div class=\"text-center no-preview-available\">\n                    \t\tPlease generate an e-Invoice to preview it.\n                    \t</div>\n                    \n                        {% else %}\n                    \t{% set e_invoice_log = frappe.db.get_value(\"e-Invoice Log\", doc.irn, (\"invoice_data\", \"signed_qr_code\"), as_dict=True) %}\n                \n                    \t{% if not e_invoice_log %}\n                    \t\t<div class=\"text-center no-preview-available\">\n                    \t\t\tThe e-Invoice Log linked to this Sales Invoice could not be found.\n                    \t\t</div>\n                    \t{% else %}\n                    \n                    \t{% if not e_invoice_log.invoice_data %}\n                    \n                \t\t<div class=\"text-center no-preview-available\">\n                \t\t\tInvoice Data is not available in the e-Invoice Log linked to this invoice.\n                \t\t</div>\n                    \n                \t\t{% else %}\n                \n                \t\t{%- set invoice_data = _dict(json.loads(e_invoice_log.invoice_data)) -%}\n                    \n                \t\t<div class=\"row section-break info-section\">\n                \t\t\t<div class=\"col-xs-8 column-break \" >\n                \t\t\t\t{%\n                \t\t\t\t\tset transaction_details = {\n                \t\t\t\t\t\t\"IRN\": invoice_data.Irn,\n                \t\t\t\t\t\t\"Ack. No.\": invoice_data.AckNo,\n                \t\t\t\t\t\t\"Ack. Date\": frappe.utils.format_datetime(\n                \t\t\t\t\t\t\tinvoice_data.AckDt, \"dd/MM/yyyy hh:mm:ss\"\n                \t\t\t\t\t\t),\n                \t\t\t\t\t}\n                \t\t\t\t%}\n                \t\t\t\t{% for key, value in transaction_details.items() %}\n                \t\t\t{% if value %}\n                \t\t\t\t<div class=\"row data-field\" style=\"font-size:14px; display:flex; align-items:end;\">\n                \t\t\t\t\t<div class=\"col-xs-4\"><label>{{ key }}</label></div>\n                \t\t\t\t\t<div class=\"col-xs-8 value\">{{ value }}</div>\n                \t\t\t\t</div>\n                \t\t\t{% endif %}\n                \t\t{% endfor %}\n                \t\t\t</div>\n                \t\t\t<div class=\"col-xs-4 column-break pull-right\" style=\"width:150px; height:auto;\">\n                \t\t\t\t{{ web_block('e-Invoice QR', values={'e_invoice_qr_text': e_invoice_log.signed_qr_code }) }}\t\n                \t\t\t</div>\n                \t\t</div>\n                    \t\t{% endif %}\n                    \t{% endif %}\n                    {% endif %}\n                  </p>\n            </td>\n        </tr>\n    </table>\n\n    <table style=\"border:1px solid black;\">\n        <thead>\n        <tr>\n            <td rowspan=\"4\"  colspan=\"12\" style=\"width: 150px; border: 1px solid black;\">\n                <div style=\"display:flex;\">\n                    <div style=\"float:left;\">\n                        {% set logo_for_printing = frappe.db.get_value('Company', 'Value Pack India Private Limited', 'logo_for_printing')%}\n                        {% if logo_for_printing != \"\" %}\n                            <img src=\"/private/files/logo.jpeg\" style=\"height: 100px; width: 100px;\"></img>\n                        {% endif %} \n                    </div>\n                    <div style=\"float:right;\">\n                     <P style=\"font-size:13px;\"> <b>{{doc.company}}</b><br>{{doc.company_address_display}}</P>\n                    </div>\n                </div>\n            </td>\n            <td colspan=\"6\" style=\"border: 1px solid black;\">\n            <div style=\"display:flex;\">\n                <div>\n                   <span style=\"font-size:10px; line-height:18px; float:left;\">Invoice No<br><b style=\"font-size:10.8px;\">{{ doc.name }}</b></span>\n                </div>\n                <div>\n                    <span style=\"font-size:10px;  line-height:18px; float:right\">e-Way Bill No<br><b style=\"font-size:10.8px;\">{{doc.ewaybill or \"\"}}</b></span>\n                </div>\n            </div>\n          </td>\n          <td colspan=\"6\" style=\"border: 1px solid black;\">\n              <span style=\"font-size:11px; line-height:18px;\">Date</span><br><b style=\"font-size:12px;\">{{ doc.posting_date }}</b>\n          </td>\n        </tr>\n        \n       \n        <tr>\n           <td colspan=\"6\" style=\"border: 1px solid black;\">\n             {% set delivery_note = frappe.db.get_value(\"Delivery Note\", doc.items[0].delivery_note, 'name') %}\n             <span style=\"font-size:11px; line-height:18px;\">Delivery Note</span><br><b style=\"font-size:12px;\">{{ delivery_note or \"\" }}</b>\n          </td>\n          <td colspan=\"6\" style=\"border: 1px solid black;\">\n             <span style=\"font-size:11px; line-height:18px;\">Buyer's Order No</span><br><b style=\"font-size:12px;\">{{ \" \" }}</b>\n          </td>\n        </tr>\n        \n        <tr>\n           <td colspan=\"6\" style=\"border: 1px solid black;\">\n              {% set delivery_note_date = frappe.db.get_value(\"Delivery Note\", doc.items[0].delivery_note, 'posting_date') %}\n              <span style=\"font-size:11px; line-height:18px;\">Delivery Note Date</span><br><b style=\"font-size:12px;\">{{ delivery_note_date or \"\" }}</b>\n          </td>\n          <td colspan=\"6\" style=\"border: 1px solid black;\">\n              {% set dispatch_from = frappe.db.get_value(\"Address\", \"Value Pack India Private Limited-Shipping\", 'city') %}\n               <span style=\"font-size:11px; line-height:18px;\">Dispatched From</span><br><b style=\"font-size:12px;\">{{ dispatch_from or \"\" }}</b>\n          </td>\n        </tr>\n        \n        <tr style=\"border: 1px solid black;\">\n          <td colspan=\"6\" style=\"border: 1px solid black;\">\n               <span style=\"font-size:11px; line-height:18px;\">Motor Vehicle No</span><br><b style=\"font-size:12px;\">{{ doc.vehicle_no }}</b>\n          </td>\n          <td colspan=\"6\" style=\"border: 1px solid black;\">\n               <span style=\"font-size:11px; line-height:18px;\">Destination</span><br><b style=\"font-size:12px;\">{{ doc.custom_transport_destination or \"\" }}</b>\n          </td>\n        </tr>\n        \n        <tr style=\"border: 1px solid black;\">\n            <td colspan=\"12\" style=\"font-size:13px; line-height:16px; border: 1px solid black; width:50%\">\n               Buyer (Bill To)<br><b>{{doc.customer or \"\"}}</b><br>{{doc.address_display or \"\"}}\n            </td>\n            <td colspan=\"12\" style=\"font-size:13px; border: 1px solid black; line-height:16px;  width:50%\">\n                Consignee (Ship To)<br><b>{{doc.shipping_address_name or \"\"}}</b><br>{{doc.shipping_address or \"\"}}\n            </td>\n        </tr>\n        \n        \n        <tr style=\"font-size: 10px; border: 1px solid black;\">\n            <td><b>Sr.</b></td>\n            <td colspan=\"9\" style=\"text-align: center; border: 1px solid black;\" ><b>Description of Goods</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>HSN</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>Qty</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>Rate <br> (incul. of tax)</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>Rate <br> (excul. of tax)</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>Disc (%)</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>Disc amt</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>Amount</b></td>\n        </tr>\n        </thead>\n        \n        <tbody>\n    \n        {% for item in doc.items %}\n            <tr style=\"font-size:10px; border: 1px solid black;\">\n                <td style=\"border-left: 1px solid black; border-right: 1px solid black;\">{{ loop.index }}</td>\n                <td colspan=\"9\" style=\"text-align: left; border-left: 1px solid black; border-right: 1px solid black;\" >{{ item.description }}</td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\">{{ item.gst_hsn_code }}</td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\">{{ item.qty }}</td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\">{{ item.rate }}</td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\">{{ item.net_rate }}</td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\">{{ item.discount_percentage }}</td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\">{{ item.discount_amount }}</td>\n                <td colspan=\"2\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"><b>{{ item.taxable_value }}</b></td>\n            </tr>    \n        {% endfor %}\n        \n        <tr style=\"font-size:10px\">\n            <td style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"9\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\" ><b>Taxable Value</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"><b>{{ doc.net_total }}</b></td>\n        </tr>\n        \n        <tr style=\"font-size:10px\">\n            <td style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"9\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\" ><b>Discount On Sale</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"><b>{{ doc.discount_amount }}</b></td>\n        </tr>\n        \n        {% for item in doc.taxes %}\n            <tr style=\"font-size:10px;\">\n                <td style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"9\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\" ><b>{{ item.description }}</b></td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n                <td colspan=\"2\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"><b>{{ item.tax_amount }}</b></td>\n            </tr>    \n        {% endfor %}\n        \n        \n        <tr style=\"font-size:10px\">\n            <td style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"9\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\" ><b>ROUND OFF</b></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border-left: 1px solid black; border-right: 1px solid black;\"></td>\n            <td colspan=\"2\" style=\"text-align: right; border-left: 1px solid black; border-right: 1px solid black;\"><b>{{ doc.rounding_adjustment }}</b></td>\n        </tr>\n        \n        {% for item in doc.items %}\n      \n        {% endfor %}\n        \n        <tr style=\"font-size:10px; border: 1px solid black;\">\n            <td style=\"border: 1px solid black;\"></td>\n            <td colspan=\"9\" style=\"text-align: right; border: 1px solid black;\" ><b>Total</b></td>\n            <td colspan=\"2\" style=\"text-align: center;\"></td>\n            <td colspan=\"2\" style=\"text-align: center;\"></td>\n            <td colspan=\"2\" style=\"text-align: center;\"></td>\n            <td colspan=\"2\" style=\"text-align: center;\"></td>\n            <td colspan=\"2\" style=\"text-align: center;\"></td>\n            <td colspan=\"2\" style=\"text-align: center; border: 1px solid black;\"><b>{{ doc.discount_amount }}</b></td>\n            <td colspan=\"2\" style=\"text-align: right; border: 1px solid black;\"><b>{{ doc.rounded_total }}</b></td>\n        </tr> \n        </tbody>\n    </table>\n    <table>\n        <tr >\n            <td colspan=\"24\" style=\"border: 1px solid black;\">\n                <span style=\"font-size:11px; line-height: 16px;\">Amount Chargeable(in Words)</span><br><b style=\"font-size:13px;\">{{ doc.in_words }}</b>\n            </td>\n        </tr>\n        \n        <tr>\n            <td colspan=\"24\" style=\"font-size:12px; border:1px solid black;\">\n                {{ doc.gst_breakup_table }}\n            </td>\n        </tr>\n        \n        <tr style=\"border-left: 1px solid black; border-right: 1px solid black;\">\n           <td colspan=\"24\" style=\"border-right: 1px solid black;\">\n               <span style=\"font-size:11px;\">Tax Amount(in Words): </span><b style=\"font-size:13px;\">{{ frappe.utils.money_in_words(doc.total_taxes_and_charges) }} </b>\n               <div style=\"font-size:11px; margin-left:320px;\">\n                   <div style=\"line-height: 16px;\">\n                       {% set bank = frappe.db.get_value('Company Print Options', {'parentfield' : 'bank_details_for_printing', 'print_label': 'Bank Name'}, 'print_value') %}\n                       {% set acc_no = frappe.db.get_value('Company Print Options', {'parentfield' : 'bank_details_for_printing', 'print_label': 'Account No.'}, 'print_value') %}\n                       {% set branch = frappe.db.get_value('Company Print Options', {'parentfield' : 'bank_details_for_printing', 'print_label': 'Branch'}, 'print_value') %}\n                       {% set ifsc = frappe.db.get_value('Company Print Options', {'parentfield' : 'bank_details_for_printing', 'print_label': 'IFSC Code'}, 'print_value') %}\n                       <p>Company's Bank Details</p>\n                       <span>Bank Name &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>:<b> {{ bank }}</b><br>\n                       <span>A/c No&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>:<b> {{ acc_no }}</b><br>\n                       <span>Branch & IFSC Code&nbsp;</span>:<b> {{ branch }} & {{ ifsc }}</b>\n                   </div>\n               </div>\n            </td> \n        </tr>\n        \n        <tr style=\"border-left: 1px solid black; border-right: 1px solid black; border-bottom: 1px solid black;\">\n            <td colspan=\"12\"> \n                <div style=\"display:flex; justify-content: space-between;\">\n                    <div style=\"\">\n                        <span>\n                            {% set pan = frappe.db.get_value('Company Print Options', {'parentfield' : 'registration_details_for_printing', 'print_label': 'PAN'}, 'print_value') %}\n                            <span style=\"font-size:11px;\">Company's PAN : </span> <b style = \"font-size:12px\">{{ pan }}</b>\n                            {% if doc.terms %}\n                                <p style=\"font-size:11px;\"><u>Terma and Conditions:</u><br>{{ doc.terms }}</p>\n                            {% endif %}\n                            <p style=\"font-size:11px;\"><u>Declaration:</u><br>We declare that this invoice shows the actual price of the goods<br>described and that all particulars are true and correct.</p>\n                        </span>\n                    </div>\n                </div>\n            </td>\n            \n            <td colspan=\"12\" style=\"border: 1px solid black\">\n                <span style=\"font-size:10px;\">\n                    <b style=\"font-size:12px; margin-left:90px\">for VALUE PACK INDIA PRIVATE LIMITED</b><br><br><br>\n                    <p style=\"margin-left:230px\"> Authorised Signatory</p>\n                </span>\n            </td>\n        </tr>\n    </table>\n</div>\n{% endfor %}\n\n\n{% if print_settings.repeat_header_footer %}\n<div id=\"footer-html\">\n    <table>\n        <tr>\n        <td style=\"border: 1px solid black; font-weight: bold; text-align:center; line-height: 15px\">\n            VBOND , BUIDLING TOGETHER & BONDING FOREVER\n        </td>\n    </tr>\n    <tr>\n        <td style=\"border: 1px solid black; text-align:center; background-color:lightgray; line-height: 14px; font-size:12px; font-weight: bold;\">\n            Tile Adhesives, Epoxy grouts, Wall putty, Water proofing, DryMix motars\n        </td>\n    </tr>\n    </table>\n    <p class=\"text-center medium page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }} \n    </p>\n    <p style=\"text-align:center;\">This is a Computer Generated Invoice</p>\n</div>\n{% endif %}\n\n",
