 "css": ".invoice-container {\n    font-size: 15px;\n    font-family: 'Arial-MT', Arial, sans-serif;\n    color: black;\n}\n\ntable {\n  width: 100%;\n  height: 100%;\n  border-collapse: collapse;\n}\n\n.print-format {\n    margin: 0 !important;\n}\n\n#footer-html {\n    display: block !important;\n\t\t\tmargin-top: 0 !important;\n\t\t\tpadding-top: 0 !important;\n}",
 "custom_format": 1,
 "default_print_language": "en",
